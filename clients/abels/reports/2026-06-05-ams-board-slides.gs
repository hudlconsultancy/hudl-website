        {color: C.yellow, size: 36, bold: true, center: true});

    txt(s, 'Marketing Performance — May 2026',
        60, 148, W - 120, 34,
        {color: C.white, size: 20, center: true});

    txt(s, 'Board Pack  ·  AGM Group',
        60, 186, W - 120, 24,
        {color: C.muted, size: 13, center: true});

    // Divider
    var line = s.insertShape(SlidesApp.ShapeType.RECTANGLE, 200, 218, W - 400, 1);
    line.getFill().setSolidFill(C.muted);
    line.getBorder().setTransparent();

    txt(s, 'Prepared by HUDL Consultancy\nWoody · Fractional Marketing Director\n5 June 2026',
        60, 228, W - 120, 60,
        {color: C.muted, size: 11, center: true});

    txt(s, 'CONFIDENTIAL — INTERNAL ONLY',
        60, H - 26, W - 120, 18,
        {color: '#444444', size: 9, center: true});
  })();

  // ── SLIDE 2 — Executive Summary ──────────────────────────────────────────
  (function() {
    var s = addSlide();
    bg(s, C.black);
    stripe(s);
    txt(s, 'EXECUTIVE SUMMARY', 20, 10, 340, 26, {color: C.yellow, size: 16, bold: true});

    var ragColor = {Green: C.green, Amber: C.amber, Red: C.red};
    var rows = [
      ['Website Visitors',  '2,478 active users',              'Stable vs Apr; spring softening',                  '−36.8% YoY — PMAX removed (strategic)',       'Amber'],
