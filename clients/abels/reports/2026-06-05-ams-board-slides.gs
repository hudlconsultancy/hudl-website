 * 3. Click the ▶ Run button (select "buildPresentation" if prompted)
 * 4. Grant Google permissions when prompted — then check the Execution Log
 *    for the link to your new presentation.
 *
 * The script creates a new Google Slides deck in your Drive,
 * fully formatted with 12 slides covering all 5 KPIs,
 * campaign activity, financial summary and Q3 roadmap.
 */

function buildPresentation() {

  // ── Create presentation ──────────────────────────────────────────────────
  var pres = SlidesApp.create('Abels Moving Services — Marketing Performance May 2026');
  var W = pres.getPageWidth();   // points (default ~720)
  var H = pres.getPageHeight();  // points (default ~405)

  // Clear the default first slide's placeholders
  var titleSlide = pres.getSlides()[0];
  titleSlide.getPageElements().forEach(function(el) { el.remove(); });

  // ── Brand colours ────────────────────────────────────────────────────────
  var C = {
    black:  '#0c0c0c',
    card:   '#111111',
    row1:   '#0d0d0d',
    white:  '#ffffff',
    yellow: '#fbbf46',
    blue:   '#45aeff',
    cyan:   '#1edfd4',
    red:    '#ff515e',
    green:  '#22c55e',
    amber:  '#f59e0b',
    muted:  '#9a9a9a',
    tblHdr: '#0a1a2a',
  };

  // ── Helpers ──────────────────────────────────────────────────────────────

  function addSlide() {
    var s = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
    s.getPlaceholders().forEach(function(p) { p.remove(); });
    return s;
  }

  function bg(slide, hex) {
    slide.getBackground().setSolidFill(hex);
  }

  // Four-colour stripe bar across the top
  function stripe(slide) {
    var bw = W / 4;
    var colors = [C.yellow, C.blue, C.red, C.cyan];
    colors.forEach(function(c, i) {
      var r = slide.insertShape(SlidesApp.ShapeType.RECTANGLE, i * bw, 0, bw, 5);
      r.getFill().setSolidFill(c);
      r.getBorder().setTransparent();
    });
  }

  // Insert a text box with styling
  function txt(slide, text, left, top, width, height, opts) {
    var o = opts || {};
    var box = slide.insertTextBox(text, left, top, width, height);
    var ts  = box.getText().getTextStyle();
    ts.setForegroundColor(o.color  || C.white);
    ts.setFontSize(o.size          || 12);
    if (o.bold)  ts.setBold(true);
    var ps = box.getText().getParagraphStyle();
    if (o.center) ps.setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER);
    return box;
  }

  // Insert a simple rectangle (for milestone boxes, etc.)
  function rect(slide, left, top, width, height, fillHex, borderHex) {
    var r = slide.insertShape(SlidesApp.ShapeType.RECTANGLE, left, top, width, height);
    r.getFill().setSolidFill(fillHex || C.card);
    if (borderHex) { r.getBorder().setSolidFill(borderHex); }
    else           { r.getBorder().setTransparent(); }
    return r;
  }

  // Build a table with header row
  function makeTable(slide, left, top, width, height, headers, rows, opts) {
    var o = opts || {};
    var t = slide.insertTable(rows.length + 1, headers.length, left, top, width, height);

    // Header row
    headers.forEach(function(h, c) {
      var cell = t.getCell(0, c);
      cell.getText().setText(h);
      var ts = cell.getText().getTextStyle();
      ts.setForegroundColor(o.headerColor || C.blue);
      ts.setBold(true);
      ts.setFontSize(o.headerSize || 10);
      cell.getFill().setSolidFill(C.tblHdr);
    });

    // Data rows
    rows.forEach(function(row, r) {
      var rowBg = (r % 2 === 0) ? C.row1 : C.black;
      if (o.rowBg && o.rowBg[r]) rowBg = o.rowBg[r];
      row.forEach(function(cellText, c) {
        var tc = t.getCell(r + 1, c);
        tc.getText().setText(String(cellText));
        var ts = tc.getText().getTextStyle();
        ts.setFontSize(o.cellSize || 10);
        var color = C.muted;
        if (c === 0) color = C.white;
        if (o.cellColor && o.cellColor[r] && o.cellColor[r][c]) color = o.cellColor[r][c];
        ts.setForegroundColor(color);
        if (o.cellBold && o.cellBold[r] && o.cellBold[r][c]) ts.setBold(true);
        tc.getFill().setSolidFill(rowBg);
      });
    });
    return t;
  }

  // ── SLIDE 1 — Title ──────────────────────────────────────────────────────
  (function() {
    var s = titleSlide;
    bg(s, C.black);
    stripe(s);
    // Decorative accent bar left
    rect(s, 0, 0, 4, H, C.yellow);

    txt(s, 'ABELS MOVING SERVICES',
