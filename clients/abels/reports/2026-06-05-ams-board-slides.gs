    bg(s, C.black);
    stripe(s);
    txt(s, 'NEXT STEPS', 20, 10, 300, 24, {color: C.yellow, size: 18, bold: true});

    var steps = [
      {label: 'Sign off Q3 brief & ad copy',            note: 'Europe, London, Domestic RSAs + landing pages ready — needed before 7 July go-live',     color: C.cyan,   owner: 'Woody → sign off'},
      {label: 'Domestic clean-up: 23 June',             note: 'JDR to implement 90 negatives + match-type changes in the Google Ads account',             color: C.yellow, owner: 'JDR Group'},
      {label: 'Budget reallocation: 7 July',            note: 'Europe & London budgets increased; Domestic reduced — total £200/day held',                color: C.yellow, owner: 'JDR Group'},
      {label: 'Re-enable Moveware offline import',      note: 'Upgrades Smart Bidding from form-fills to revenue optimisation (2025: 88 leads, £44k)',    color: C.blue,   owner: 'Woody + JDR + NetDesigner'},
      {label: 'June 2026 board report',                 note: 'First full month with reallocation active — expected improvement in CPL and lead volume', color: C.muted,  owner: 'HUDL (Pippa) — July'},
    ];

    steps.forEach(function(step, i) {
      var y = 42 + i * 52;
      var box = s.insertShape(SlidesApp.ShapeType.RECTANGLE, 20, y, W - 40, 46);
      box.getFill().setSolidFill(C.row1);
      box.getBorder().setTransparent();
      // Accent strip
      var accent = s.insertShape(SlidesApp.ShapeType.RECTANGLE, 20, y, 3, 46);
      accent.getFill().setSolidFill(step.color);
      accent.getBorder().setTransparent();
      txt(s, step.label, 30, y + 4,  W - 180, 18, {color: C.white, size: 12, bold: true});
      txt(s, step.note,  30, y + 22, W - 180, 18, {color: C.muted, size: 10});
      txt(s, step.owner, W - 155, y + 10, 130, 22, {color: step.color, size: 10, bold: true, center: true});
    });

    txt(s, 'HUDL Consultancy · Woody · woody@hudl.gg · Internal — not for external distribution',
        20, H - 22, W - 40, 14, {color: '#333333', size: 8, center: true});
  })();

  // ── Done ─────────────────────────────────────────────────────────────────
  var url = pres.getUrl();
  Logger.log('');
  Logger.log('✅  Presentation created successfully!');
  Logger.log('🔗  Open it here: ' + url);
  Logger.log('📋  ID: ' + pres.getId());
