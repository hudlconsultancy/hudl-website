    txt(s, '▸ Single booked job (avg £5,508 · 38.5% GM) covers ~32–42 lead-form enquiries at current CPL. Europe and London are profitable but budget-throttled; Domestic is the structural outlier being fixed in Q3.',
        20, H - 20, W - 40, 16, {color: C.muted, size: 9});
  })();

  // ── SLIDES 3–7 — KPI Deep-Dives ──────────────────────────────────────────
  var kpis = [
    {
      num: '01', title: 'Website Visitors', color: C.blue,
      what: '2,478 active users · 2,847 sessions in May\n13,329 active users Jan–May\n−36.8% YoY (May 2025: 3,918)',
      why:  'Decline is strategic, not a failure. In 2025, Performance Max generated 11.4 million impressions — almost entirely low-intent display traffic with sub-1% CTR. We removed PMAX and switched to five targeted Search-only campaigns.\n\nTraffic volume is down; audience quality is up.',
      how:  '9.6% Search conversion rate proves the higher-quality audience. Three levers to recover volume:\n• Unlock Europe\'s 44% lost impression share\n• Unlock London\'s 63% lost impression share\n• Structured SEO activity\n\nBoth impression-share gaps are addressed in Q3 reallocation (7 July).'
    },
    {
      num: '02', title: 'Conversion Volume', color: C.cyan,
      what: '37 lead forms in May\n124 Group 2 form submissions Jan–May (≈24.8/mo)\n\nNOTE: Group 2 = genuine form enquiries only. 2026 counts only this.',
      why:  '2025 counted soft actions (page views, phone clicks, get-directions) as conversions — producing the misleading £21 CPA and ≈177 conv/month. In 2026 those are switched off.\n\nGenuine 2025 rate was ≈49 form subs/month vs 2026 ≈25/month. The gap reflects: −37% traffic (PMAX removed) + lower budget + Domestic structural inefficiency.',
      how:  'Europe drove 19 of May\'s 37 conversions (51%) — the clearest signal of where budget belongs.\n\nEurope and London are "budget limited" — campaigns stop serving mid-day when their daily cap is reached. 124 enquiries is a floor, not a ceiling. Q3 reallocation directly targets this constraint.'
    },
    {
      num: '03', title: 'Conversion Quality', color: C.green,
      what: '53 jobs won · £291,919 won revenue · Jan–May 2026\n38.5% gross margin (up from 31.3% in 2025)\n£5,508 average won job value\n21 average days to book (down from 41 in 2025)\n\nSource: AGM Power BI · all channels, not paid media only.',
      why:  'The commercial proof point: enquiries are converting into higher-margin jobs, faster. Gross margin improved materially (31.3%→38.5%). Deals close in half the time (41→21 days). Average job value is steady at ~£5,500 — no evidence of trading down.\n\nThe business is winning better jobs, not just more jobs.',
      how:  'Commercial framing: £130–170 CPL against £5,508 avg won job at 38.5% GM (~£2,120 gross profit) = each booked job covers 12–16 lead-form enquiries at cost.\n\nRouting budget toward Europe and London — lowest CPL, highest win rate — is the lever to lift monthly won revenue without touching margin.'
    },
    {
      num: '04', title: 'Cost per Lead (CPL)', color: C.yellow,
      what: '£160 blended (May)\n£165 blended Jan–May\n\nBy campaign (Jan–May):\nEurope £130 · London £151 · International £174\nDomestic £299 · Brand £24',
      why:  '£165 blended CPL is commercially sound — see KPI 3.\n\nDomestic is the structural outlier: £299/enquiry against a £165 blended average, and the only campaign returning less value than it costs (0.74×). Root cause: irrelevant query triggering — man-and-van, self-storage, recruitment searches diluting conversion rate.',
      how:  'Domestic Clean-Up Pack (live 23 June):\n• 90 negative keywords across waste categories\n• Core terms migrated from broad → phrase/exact match\n• tCPA target recalibrated\n\nTarget: £200–230 CPA from £299 over 6–8 weeks.\nQ3 reallocation channels freed budget into Europe and London where each pound works hardest.'
    },
    {
      num: '05', title: 'Spend vs Budget', color: C.cyan,
      what: 'May 2026 Search: £5,929 (of ~£6,200 ceiling = 96%)\nJan–May 2026 Search total: £22,364\nMonthly trend: Jan £3,751 · Feb £1,339 · Mar £5,242 · Apr £6,103 · May £5,929\n\nBudget ceiling: £200/day confirmed by Neil Pertoldi.',
      why:  'The account is running at effective capacity in Apr–May (99–96% utilisation). The goal is not to spend as much as possible, but to spend in the places that generate the most profitable enquiries.\n\n£200/day total is held in Q3 — the reallocation changes the distribution, not the total.',
      how:  'Q3 reallocation (go-live 7 July):\nEurope: £97 → £115–130/day\nLondon: £28 → £45–55/day\nDomestic: £40 → £20/day\nInternational + Brand: unchanged\n\nPhased: Domestic clean-up 23 Jun → budget shift 7 Jul → tCPA calibration 14 Jul.\nSmart Bidding needs 2–4 weeks to recalibrate after each change.'
    },
  ];

  kpis.forEach(function(kpi) {
    var s = addSlide();
    bg(s, C.black);
    stripe(s);

    // Badge + title
    var badge = s.insertShape(SlidesApp.ShapeType.ROUND_RECTANGLE, 20, 10, 56, 22);
    badge.getFill().setSolidFill(kpi.color);
    badge.getBorder().setTransparent();
    txt(s, 'KPI ' + kpi.num, 20, 10, 56, 22, {color: C.black, size: 10, bold: true, center: true});
    txt(s, kpi.title.toUpperCase(), 84, 10, W - 104, 22, {color: C.white, size: 16, bold: true});

    // Three-column layout
    var colW  = (W - 50) / 3;
    var col2x = 20 + colW + 5;
    var col3x = 20 + colW * 2 + 10;
    var labelY = 38, colY = 56, colH = H - colY - 16;

    // Label headers
    [['WHAT', 20], ['WHY', col2x], ['HOW', col3x]].forEach(function(pair) {
      txt(s, pair[0], pair[1], labelY, colW, 14, {color: kpi.color, size: 9, bold: true});
    });

    // Content boxes
    function col(text, x) {
      var box = s.insertTextBox(text, x, colY, colW, colH);
      box.getText().getTextStyle().setForegroundColor(C.muted).setFontSize(10);
      box.getFill().setSolidFill(C.row1);
    }
    col(kpi.what, 20);
    col(kpi.why, col2x);
    col(kpi.how, col3x);
  });

  // ── SLIDE 8 — Campaign Activity ──────────────────────────────────────────
  (function() {
    var s = addSlide();
    bg(s, C.black);
    stripe(s);
    txt(s, 'CAMPAIGN ACTIVITY — MAY / JUNE 2026', 20, 10, W - 40, 24, {color: C.yellow, size: 14, bold: true});

    var statusColors = {Completed: C.green, Prepared: C.amber, Recommended: C.blue};
    var rows = [
      ['Account audit & diagnosis',          'Full campaign review — identified Domestic over-funded, Europe/London under-funded', 'Completed',   'Pippa',          'Done'],
      ['Domestic clean-up pack',             '90 negatives + match-type tightening · target CPA £200–230 from £299',              'Prepared',    'Pippa',          '23 Jun'],
      ['Budget reallocation',               'Europe ↑ London ↑ Domestic ↓ · total held at £200/day',                             'Prepared',    'Pippa',          '7 Jul'],
      ['Q3 brief + RSA ad copy',            '15 headlines + 4 descriptions per campaign + Europe & London landing pages',         'Completed',   'Hunter / Otis',  'Sign-off needed'],
      ['GA4 analytics review',              'Dashboard updated; quote-path UX opportunity flagged (4.1% key-event rate)',         'Completed',   'Dash',           'Done'],
      ['Conversion tracking reconciliation','Proved 2025 counted soft actions; 2026 counts form submits only',                    'Completed',   'Pippa',          'Done'],
      ['Offline conversion import',         'Re-enable Moveware→Google Ads (88 qualified leads / £44k in 2025 — 0 in 2026)',     'Recommended', 'Woody + JDR',    'Q3'],
    ];

    var cellColor = rows.map(function(row) {
      return [C.white, C.muted, statusColors[row[2]] || C.muted, C.muted, C.muted];
    });
