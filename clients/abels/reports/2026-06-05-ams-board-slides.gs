      ['Conversion Quality','38.5% GM · £5,508 avg job · 21d','GM up (31.3%→38.5%); speed doubled (41→21 days)', 'Margin and speed both improving YoY',           'Green'],
      ['Cost per Lead',     '£160 blended (May)',              'Holding £160–165 since Apr after Mar spike (£228)','Genuine 2025 CPL ≈£46 — different definition',  'Green'],
      ['Spend vs Budget',   '£5,929 of ~£6,200 (96%)',        'Near-capacity since Apr (99–96%)',                  '£200/day confirmed by Neil Pertoldi',           'Green'],
    ];

    var cellColor = rows.map(function(row) {
      return [C.white, C.muted, C.muted, C.muted, ragColor[row[4]] || C.muted];
